# MongoDB (local: mongodb://127.0.0.1:27017/reevoai)
MONGODB_URI=mongodb://127.0.0.1:27017/reevoai

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional — unsigned upload preset from Cloudinary dashboard (Settings → Upload)
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Free tier (2026): gemini-2.5-flash-lite (best quota), gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Auth (change in production)
JWT_SECRET=change-me-to-a-long-random-string

# Server
API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Public URLs (use your frontend port if different, e.g. 8080)
PUBLIC_APP_URL=http://localhost:8080
API_PUBLIC_URL=http://127.0.0.1:3001
NODE_ENV=development

# Vercel production — set these in the Vercel project dashboard
# CLIENT_ORIGIN=https://your-app.vercel.app
# PUBLIC_APP_URL=https://your-app.vercel.app
# NODE_ENV=production
